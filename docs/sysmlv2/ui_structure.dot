digraph UI {
 graph [bgcolor="#10151f", pad=.35, ranksep=.56, nodesep=.58, fontname="DejaVu Sans", label="INVESTLAB • СТРУКТУРА ИНТЕРФЕЙСА (SysMLv2)", labelloc=t, fontsize=19, fontcolor="#eaf1ff"];
